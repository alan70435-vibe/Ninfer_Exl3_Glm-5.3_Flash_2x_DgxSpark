HEAD_IP=192.168.100.10
WORKER_IP=192.168.100.11
HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f1
NCCL_IB_GID_INDEX=3
HEAD_GID=3
WORKER_GID=3

MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_FALLBACK=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
PORT=8888
SERVED_MODEL_NAME=GLM-5.3-Flash-EXL3

TP=2
NNODES=2
MASTER_PORT=29521
QUANTIZATION=exl3
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
EXL3_FAT_GROUPED=1
EXL3_TEMP_ROWS_FUSED=32

SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2
MTP_TOKENS=2

MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=7168
GPU_MEM_UTIL=0.85
KV_CACHE_DTYPE=fp8
GLM53_INDEXER_WORKSPACE=rightsize
GLM53_ADAPTIVE_K=ema
GLM53_ADAPTIVE_K_SET=2,4,7
GLM53_DENSE_FP8=off
EXTRA_ARGS="--cudagraph-capture-sizes 1 2 3 4 5 8"

USE_HOST_NCCL=0
DEFAULT_MAX_NEW_TOKENS=65536
GLM53_MIXED_PREFILL_CHUNK=fair
GLM53_FAIR_PREFILL_CHUNK=256
GLM53_FAIR_PREFILL_SHARE=0.30
GLM53_FAIR_PREFILL_MAX_INTERVAL_MS=2000
GLM53_FAIR_PREFILL_MAX_STEP_MS=2000
GLM53_FAIR_PREFILL_MAX_CHUNKS=1
